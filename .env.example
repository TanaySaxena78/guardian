# Copy this file to .env and fill in your keys. Never commit .env.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq key for Llama Prompt Guard 2 (optional but recommended): https://console.groq.com/keys
GROQ_API_KEY=

# Model ids. Check the current ids in AI Studio and the Groq console before running.
AGENT_MODEL=gemini-3.8-flash
JUDGE_MODEL=gemini-3.5-flash-lite
RULES_MODEL=gemini-3.5-flash-lite
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-22m
PROMPT_GUARD_THRESHOLD=0.5

# Limits
MAX_AGENT_TURNS=30
RUNS_PER_IP_PER_HOUR=15

# Only needed when the frontend runs on a different address than the backend
ALLOWED_ORIGINS=http://localhost:5173
